#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
                &kp Q    &kp W    &kp E    &kp R    &kp T               &kp Y       &kp U    &kp I    &kp O    &kp P
                &kp A    &kp S    &kp D    &kp F    &mt LSHFT G         &mt RSHFT H &kp J    &kp K    &kp L    &kp SQT
                &kp Z    &kp X    &kp C    &kp V    &kp B               &kp N       &kp M    &kp LCTL &kp RALT &kp DOT
                                  &kp LGUI &mo 1    &kp SPACE           &kp RET     &mo 2    &kp BSPC
            >;
        };

        lower {
            display-name = "Lower";
            bindings = <
                &trans &trans &trans &trans &trans        &trans   &trans   &trans &trans    &trans
                &trans &trans &trans &trans &trans        &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans
                &trans &trans &trans &trans &trans        &trans   &trans   &trans &trans    &trans
                              &trans &trans &trans        &trans   &kp ESC  &kp TAB
            >;
        };

        raise {
            display-name = "Raise";
            bindings = <
                &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
                              &trans &trans &trans        &trans &trans &trans
            >;
        };

        // additional layers for use through ZMK Studio

        extra_1 {
                status = "reserved";
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };

    };
};
